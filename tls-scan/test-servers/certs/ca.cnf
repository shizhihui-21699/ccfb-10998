[ ca ]
default_ca = CA_default
[ CA_default ]
dir = /Users/shizhihui/ccfb/runs/10998/workspace/tls-scan/test-servers/certs
database = $dir/index.txt
new_certs_dir = $dir
certificate = $dir/ca.pem
private_key = $dir/ca-key.pem
serial = $dir/serial
default_md = sha256
default_days = 825
copy_extensions = copy
unique_subject = no
policy = policy_any
[ policy_any ]
commonName = supplied
organizationName = optional
