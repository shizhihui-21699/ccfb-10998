{
  "name": "tls-doctor",
  "version": "1.0.0",
  "private": true,
  "description": "Active TLS configuration health-check tool for internal services",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "tls-doctor": "./bin/tls-doctor.ts"
  },
  "scripts": {
    "tls-doctor": "node --no-warnings src/cli.ts",
    "probe": "node --no-warnings src/cli.ts probe",
    "scan": "node --no-warnings src/cli.ts scan",
    "fixtures": "node --no-warnings fixtures/serve.ts",
    "gen:suites": "node scripts/gen-suites.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --no-warnings --test test/*.test.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
